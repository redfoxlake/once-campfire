<%# Slack-style quick-reaction strip — revealed on message hover (desktop pointer only).
    Posts to the same boosts endpoint as the options-menu emoji, so it reuses the
    entire reaction backend (create + Turbo broadcast). Additive: the menu emoji stay. %>
<div class="message__quick-reactions" aria-label="Quick reactions">
  <% EmojiHelper::REACTIONS.each do |character, title| %>
    <%= form_with model: [ message, Boost.new ], data: { turbo_frame: dom_id(message, :boosting) } do |form| %>
      <%= hidden_field_tag "boost[content]", character %>
      <%= form.button type: "submit", title: title, class: "btn message__quick-react-btn", data: { emoji: character } do %>
        <figure class="margin-none boost-character"><%= character %></figure>
        <span class="for-screen-reader"><%= title %></span>
      <% end %>
    <% end %>
  <% end %>
</div>
